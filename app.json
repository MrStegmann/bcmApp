{
  "expo": {
    "name": "Basket Club Manager",
    "slug": "bcmApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bcm.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/bcm.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.patrickjs.bcmApp",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/bcm.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Permite a Basket Club Manager guardar imágenes de estadísticas en la galería.",
          "savePhotosPermission": "Permite a Basket Club Manager guardar imágenes de estadísticas en la galería."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "da35109f-0a95-49f7-90cb-fab42e991460"
      }
    }
  }
}